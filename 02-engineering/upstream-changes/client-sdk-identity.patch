+
+abstract interface class FlutterIdentityExtension {
+  String get provider;
+  Future<Map<String, dynamic>> authenticate(Map<String, dynamic> challenge);
+}
+
+/// Stable application context shared by all FL client SDKs.
+class FenlengAuthConfig {
+  const FenlengAuthConfig({
+    required this.applicationCode,
+    this.clientTarget = 'mobile',
+    this.clientId,
+  });
+  final String applicationCode;
+  final String clientTarget;
+  final String? clientId;
+  String get resolvedClientId => clientId ?? '$applicationCode-$clientTarget';
+}
diff --git a/packages/sdk-flutter/lib/src/auth_storage.dart b/packages/sdk-flutter/lib/src/auth_storage.dart
new file mode 100644
index 0000000..58ee0c4
--- /dev/null
+++ b/packages/sdk-flutter/lib/src/auth_storage.dart
@@ -0,0 +1,25 @@
+part of 'auth.dart';
+
+Future<void> _storeTokenPair(
+    FlutterAuthSDK auth, Map<String, dynamic> tokens) async {
+  final access = tokens['accessToken'], refresh = tokens['refreshToken'];
+  if (access is! String ||
+      refresh is! String ||
+      access.trim().isEmpty ||
+      refresh.trim().isEmpty ||
+      RegExp(r'[\r\n]').hasMatch(access + refresh)) {
+    throw const FenlengSdkException(
+        'TOKEN_RESPONSE_INVALID', 'Invalid token response');
+  }
+  try {
+    await auth.client.options.storage
+        .setItem(auth.client.options.tokenKey, access);
+    await auth.client.options.storage.setItem(auth._refreshKey, refresh);
+  } catch (_) {
+    await Future.wait([
+      auth.client.options.storage.removeItem(auth.client.options.tokenKey),
+      auth.client.options.storage.removeItem(auth._refreshKey),
+    ]);
+    rethrow;
+  }
+}
diff --git a/packages/sdk-flutter/test/apple_auth_test.dart b/packages/sdk-flutter/test/apple_auth_test.dart
