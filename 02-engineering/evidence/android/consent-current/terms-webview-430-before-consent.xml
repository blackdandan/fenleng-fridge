="false" selected="false" bounds="[0,71][135,165]" /><node index="1" text="用户协议" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[135,60][1080,165]" /></node><node index="1" text="" resource-id="" class="android.webkit.WebView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,165][1080,2280]"><node index="0" text="" resource-id="" class="android.webkit.WebView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="true" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,165][1080,2281]"><node index="0" text="" resource-id="" class="android.view.View" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,268][1022,2281]"><node index="0" text="用户协议（草案）" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,268][1022,363]" /><node index="1" text="版本：2026-11-13 / V0.4。生效日期：正式发布时填写；本稿供产品审阅，尚未上线。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,403][1022,559]" /><node index="2" text="1. 服务与运营者" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,637][1022,735]" /><node index="3" text="本协议适用于暂以「冰箱库存管理」描述的个人食材记录应用及配套官网。运营者为杭州临安芬棱软件设计工作室（个体工商户），地址：浙江省杭州市临安区青山湖街道科技大道2508号4幢813-442室，联系邮箱 fenlengtech@163.com，联系电话 18234132630。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,775][1022,1240]" /><node index="4" text="请阅读本协议及隐私政策。首次使用时主动选择「同意并继续」后进入服务；如暂不同意，可返回阅读或停止使用。涉及系统权限时另由你主动授权。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1280][1022,1589]" /><node index="5" text="2. 服务范围" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1667][1022,1765]" /><node index="6" text="你可拍摄或选取照片建立食材记录，按冷藏、冷冻、常温管理，整理剩余状态、查看历史并安排本地检查提醒。不要求填写账号密码，拟通过共享平台建立应用隔离的游客身份。游客身份不提供换机恢复或跨设备库存同步。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,1805][1022,2195]" /><node index="7" text="检查时间是自行确认食材状态的提示，不是保质期或食用安全判断。请结合实际保存条件、包装标识及食材状况判断；应用不提供医疗、营养或食品安全鉴定。系统权限、系统省电策略或设备状态可能影响提醒送达，可在应用内主动检查库存。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[57,2232][1022,2281]" /><node index="8" text="微信小程序可在你登录并主动允许后尝试发送订阅提醒。同一自然日合并为一次消息；许可、微信规则、网络或服务状态可能影响送达，已处理或延期的食材以应用内当前记录为准。关闭提醒、退出账号或撤回同意会申请取消未发送计划，取消未确认时会提示重试；已交由微信处理的消息可能无法撤回。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="9" text="3. 数据与设备" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="10" text="食材照片、库存及历史保存在本机；卸载、清除应用数据或设备故障可能导致丢失，目前不提供云端备份。你可修改、移出、恢复或删除记录。删除和重置操作将明确说明影响，不以游客会话恢复承诺找回本机数据。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="11" text="游客会话、反馈与最少必要产品分析使用联网共享服务，处理方式见隐私政策。中国渠道可选微信及Apple登录，全球渠道可选经Firebase认证的Google及Apple登录；Apple入口仅面向支持的平台。全球渠道可先使用本机功能，主动进入联网功能时再确认协议。请勿在意见中提交密码、身份证件、支付信息等无关敏感资料。预览、未配置或未开放的状态不代表平台已经受理、通知已经送达或正式发行已完成。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="12" text="4. 使用规则与权利" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="13" text="你保留自行拍摄或合法使用的图片及内容的权利。请勿提交违法、侵权或危害服务正常运行的内容。本应用不因你使用本地照片而获得将照片公开、售卖或用于模型训练的许可。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="14" text="应用软件、界面及运营方提供内容的相关权利归其合法权利人所有。法律允许范围内的正常使用不受本条限制。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="15" text="5. 服务调整与责任" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="16" text="版本更新、维护或外部系统变化可能影响部分功能，我们会对重大调整作出适当说明。因应用自身问题造成的责任按适用法律承担，本协议不排除或限制依法应承担的责任及消费者法定权利。暂不含付费、广告、分享或云同步；如新增，将更新规则并完成相应告知。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="17" text="6. 终止、争议与联系" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="18" text="你可停止使用、在隐私政策页撤回统一隐私授权，或按需删除本机数据。撤回不自动删除本机库存，也不影响撤回前依法进行的处理；涉及服务端信息的查阅、更正、删除等请求可通过反馈或上述联系方式提出。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /><node index="19" text="重大规则变化会重新提示，不将继续浏览视为重新同意。本协议适用中华人民共和国法律；争议优先协商，协商不成可依法向有管辖权的人民法院提起诉讼。" resource-id="" class="android.widget.TextView" package="com.fenlengtech.fridge" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][0,0]" /></node></node></node></node></node></node></node></hierarchy>