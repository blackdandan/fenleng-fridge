{
  "version": "1.0",
  "consentSource": "unified-privacy-v0.3",
  "separateAnalyticsToggle": false,
  "previewTransport": "local-only",
  "commonContext": ["platform", "appVersion", "buildNumber", "releaseChannel", "locale"],
  "events": [
    {"name": "fridge.home.viewed.v1", "properties": {}},
    {"name": "fridge.capture.started.v1", "properties": {"source": ["camera", "album"], "zone": ["cold", "frozen", "pantry"]}},
    {"name": "fridge.permission.resolved.v1", "properties": {"permission": ["camera", "notifications"], "result": ["granted", "denied", "restricted", "cancelled"]}},
    {"name": "fridge.inventory.added.v1", "properties": {"source": ["camera", "album"], "zone": ["cold", "frozen", "pantry"], "result": ["success", "read_failed", "save_failed"]}},
    {"name": "fridge.review.updated.v1", "properties": {"state": ["full", "half", "little", "gone"], "zone": ["cold", "frozen", "pantry"]}},
    {"name": "fridge.reminder.opened.v1", "properties": {"source": ["home", "settings", "notification"]}},
    {"name": "fridge.feedback.submitted.v1", "properties": {"result": ["success", "network_failed", "identity_unavailable"]}},
    {"name": "fridge.website.preview.opened.v1", "properties": {"target": ["app"]}}
  ],
  "forbidden": ["image", "food", "recordId", "recordNumber", "message", "email", "phone", "token", "deviceId", "errorText"],
  "verification": ["no events before unified consent", "unknown events or properties rejected", "enum values only", "one event per committed action", "withdrawal clears pending events", "no network requests in preview"]
}
