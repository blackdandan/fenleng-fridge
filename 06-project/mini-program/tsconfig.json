{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "react"
    ],
    "baseUrl": ".",
    "paths": {
      "@fridge/domain": [
        "packages/domain/src/index.ts"
      ],
      "@fridge/application": [
        "packages/application/src/index.ts"
      ],
      "@fridge/api-client": [
        "packages/api-client/src/index.ts"
      ],
      "@fridge/ui-kit": [
        "packages/ui-kit/src/index.ts"
      ],
      "@fridge/platform-contracts": [
        "packages/platform-contracts/src/index.ts"
      ],
      "@fridge/weapp": [
        "packages/platform-adapters/weapp/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ]
}
